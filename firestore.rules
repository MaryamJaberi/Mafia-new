rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // پروندهٔ کاربر: فقط خودِ کاربر می‌خواند و می‌نویسد.
    // (اپ هم جز پروندهٔ کاربر جاری چیزی نمی‌خواند.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // اتاق بازی: ساختن برای هر کاربر واردشده، ولی تغییر و پاک‌کردن فقط به دست میزبان.
    // اتاق‌های قدیمی hostUid ندارند؛ برای نشکستن آن‌ها قاعده عقب‌سازگار است.
    // وقتی اپ هنگام ساختن اتاق hostUid را بنویسد، شرط دوم خودبه‌خود فعال می‌شود.
    match /rooms/{roomId} {
      function isHost() {
        return isAuthenticated() &&
               ('hostUid' in resource.data) &&
               resource.data.hostUid == request.auth.uid;
      }
      function isLegacyRoom() {
        return !('hostUid' in resource.data);
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isHost() || (isAuthenticated() && isLegacyRoom());
    }

    // Saved Game Notes / User Logs
    match /savedNotes/{noteId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
    }
  }
}
